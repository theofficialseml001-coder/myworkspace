```gitignore
# Dependencies
vendor/

# Logs
*.log

# Environment
.env
.env.local
.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.pyc
__pycache__/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Coverage
coverage/
htmlcov/
.coverage

# Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```