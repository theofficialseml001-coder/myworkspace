```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/
*.class

# Dependencies
.venv/
venv/
node_modules/
vendor/
composer.lock

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
coverage/
htmlcov/

# PHP specific
*.php~
*.bak
.htaccess
```